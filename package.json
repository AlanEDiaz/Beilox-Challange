{
  "name": "beilox-qa-automation-challenge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Beilox QA Automation challenge: Playwright + TypeScript (UI + API)",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui-chromium --project=ui-firefox --project=ui-webkit",
    "test:ui:chromium": "playwright test --project=ui-chromium",
    "test:api": "playwright test --project=api --workers=1",
    "test:security": "playwright test --project=security",
    "coverage": "node scripts/run-coverage.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "npm run typecheck && npm run lint && npm run format:check",
    "report": "playwright show-report"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "c8": "^12.0.0",
    "dotenv": "^18.0.10",
    "eslint": "^10.14.0",
    "eslint-plugin-playwright": "^2.12.2",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
